---
interface Props {
  title: string;
  url: string;
  description?: string;
}

const { title, url, description } = Astro.props;

// Encode for URL sharing
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDescription = description ? encodeURIComponent(description) : "";

// Social share URLs
const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const emailUrl = `mailto:?subject=${encodedTitle}&body=${encodedDescription}%0A%0A${encodedUrl}`;
---

<div class="flex flex-wrap items-center gap-3">
  <span class="text-sm font-medium text-inherit opacity-80">Share:</span>

  <a
    href={twitterUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hover:border-primary hover:bg-primary/10 flex items-center gap-2 rounded-lg border border-inherit/20 px-4 py-2 transition-colors duration-300"
    aria-label="Share on Twitter">
    <svg
      class="h-5 w-5"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true">
      <path
        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z">
      </path>
    </svg>
    <span class="hidden sm:inline">Twitter</span>
  </a>

  <a
    href={facebookUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hover:border-primary hover:bg-primary/10 flex items-center gap-2 rounded-lg border border-inherit/20 px-4 py-2 transition-colors duration-300"
    aria-label="Share on Facebook">
    <svg
      class="h-5 w-5"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true">
      <path
        d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z">
      </path>
    </svg>
    <span class="hidden sm:inline">Facebook</span>
  </a>

  <a
    href={linkedinUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hover:border-primary hover:bg-primary/10 flex items-center gap-2 rounded-lg border border-inherit/20 px-4 py-2 transition-colors duration-300"
    aria-label="Share on LinkedIn">
    <svg
      class="h-5 w-5"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true">
      <path
        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z">
      </path>
    </svg>
    <span class="hidden sm:inline">LinkedIn</span>
  </a>

  <a
    href={emailUrl}
    class="hover:border-primary hover:bg-primary/10 flex items-center gap-2 rounded-lg border border-inherit/20 px-4 py-2 transition-colors duration-300"
    aria-label="Share via Email">
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
      </path>
    </svg>
    <span class="hidden sm:inline">Email</span>
  </a>

  <button
    id="copy-link-btn"
    class="hover:border-primary hover:bg-primary/10 flex items-center gap-2 rounded-lg border border-inherit/20 px-4 py-2 transition-colors duration-300"
    aria-label="Copy link"
    data-url={url}>
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z">
      </path>
    </svg>
    <span class="hidden sm:inline" id="copy-link-text">Copy Link</span>
  </button>
</div>

<script>
  function initCopyLink() {
    const copyBtn = document.getElementById("copy-link-btn");
    const copyText = document.getElementById("copy-link-text");

    if (!copyBtn) return;

    copyBtn.addEventListener("click", async () => {
      const url = copyBtn.getAttribute("data-url");
      if (!url) return;

      try {
        await navigator.clipboard.writeText(url);

        // Show success feedback
        if (copyText) {
          const originalText = copyText.textContent;
          copyText.textContent = "Copied!";

          setTimeout(() => {
            copyText.textContent = originalText;
          }, 2000);
        }
      } catch (err) {
        console.error("Failed to copy link:", err);
      }
    });
  }

  // Initialize on page load
  initCopyLink();

  // Re-initialize after navigation (for Astro view transitions)
  document.addEventListener("astro:page-load", initCopyLink);
</script>
