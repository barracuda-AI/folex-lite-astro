---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import { ghostClient, type GhostPost } from "@/lib/ghost";
import { sanitizeGhostHtml } from "@/lib/utils/sanitizeHtml";
import ReadingProgress from "@/components/blog/ReadingProgress.astro";
import ShareButtons from "@/components/blog/ShareButtons.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";

export async function getStaticPaths() {
  try {
    const posts = await ghostClient.posts.browse({
      limit: "all",
      include: ["tags", "authors"] as any,
    });

    if (!posts || posts.length === 0) {
      console.warn("No posts found from Ghost CMS");
      return [];
    }

    return posts.map((post, index) => {
      // Get previous and next posts for navigation
      const prevPost = index > 0 ? posts[index - 1] : null;
      const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

      // Find related posts based on shared tags
      const currentTags = post.tags?.map((tag) => tag.id) || [];
      const relatedPosts = posts
        .filter((p) => {
          if (p.id === post.id) return false; // Exclude current post
          const postTags = p.tags?.map((tag) => tag.id) || [];
          // Check if posts share at least one tag
          return postTags.some((tag) => currentTags.includes(tag));
        })
        .slice(0, 3) // Limit to 3 related posts
        .map((p) => ({
          title: p.title,
          slug: p.slug,
          feature_image: p.feature_image,
          excerpt: p.excerpt,
          reading_time: p.reading_time,
        }));

      return {
        params: {
          slug: post.slug,
        },
        props: {
          post: post,
          prevPost: prevPost
            ? { title: prevPost.title, slug: prevPost.slug }
            : null,
          nextPost: nextPost
            ? { title: nextPost.title, slug: nextPost.slug }
            : null,
          relatedPosts: relatedPosts,
        },
      };
    });
  } catch (err) {
    console.error("Error fetching posts for static paths:", err);
    // Return empty array to prevent build failure
    // This will result in all /post/* routes returning 404
    return [];
  }
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;

// Validate that we have a post (additional safety check)
if (!post) {
  return Astro.redirect("/404");
}

// Generate canonical URL
const canonicalURL = new URL(
  `/post/${post.slug}`,
  Astro.site || Astro.url.origin,
).href;

// Prepare structured data for article
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.meta_description || post.custom_excerpt || post.excerpt,
  image: post.feature_image || post.og_image,
  datePublished: post.published_at,
  dateModified: post.updated_at,
  author: {
    "@type": "Person",
    name: post.primary_author?.name || "Unknown Author",
    url: post.primary_author?.website,
  },
  publisher: {
    "@type": "Organization",
    name: Astro.site?.hostname || "Blog",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
};

// Prepare keywords from tags
const keywords =
  post.tags?.map((tag) => tag.name).filter((name): name is string => !!name) ||
  [];

// Sanitize HTML content to prevent XSS
const sanitizedHtml = post.html ? sanitizeGhostHtml(post.html) : "";
---

<Base
  title={post.meta_title || post.title}
  metaTitle={post.og_title || post.meta_title || post.title}
  metaDescription={post.meta_description ||
    post.custom_excerpt ||
    post.excerpt ||
    ""}
  canonical={post.canonical_url || canonicalURL}
  keywords={keywords}
  headerPosition="fixed"
  hasHeaderDarkBackground={true}
  structuredData={structuredData as any}>
  <ReadingProgress />
  <section class="text-light mb-24 bg-black pt-52 md:mb-32">
    <div class="container">
      <div class="mx-auto max-w-7xl space-y-7 text-center md:space-y-10">
        {
          post.title && (
            <h1
              data-aos="reveal-anim-top"
              data-aos-duration="1500"
              class:list={[
                "text-inherit",
                "text-display-5 md:text-display-3 xl:text-display-2",
                "block leading-tight font-bold break-words text-inherit",
              ]}
              set:html={post.title}
            />
          )
        }
        {
          post.feature_image && (
            <div
              data-aos="reveal-anim-top"
              data-aos-duration="1500"
              data-aos-delay="300"
              data-aos-offset="0"
              class="mx-auto mt-10 -mb-24 max-w-4xl md:mt-20 md:-mb-32">
              <Image
                src={post.feature_image}
                alt={post.title || ""}
                class="h-110 w-full object-cover md:h-135"
                inferSize={true}
              />
            </div>
          )
        }
      </div>
    </div>
  </section>
  <section class="overflow-hidden pt-16 md:pt-32">
    <div class="container">
      <div
        data-aos="reveal-anim-top"
        data-aos-delay="200"
        data-aos-duration="1500"
        class="mx-auto mb-12 flex max-w-4xl flex-wrap items-center justify-center gap-4 text-inherit opacity-80">
        {
          post.primary_author && (
            <div class="flex items-center gap-2">
              {post.primary_author.profile_image && (
                <img
                  src={post.primary_author.profile_image}
                  alt={post.primary_author.name || "Author"}
                  class="h-10 w-10 rounded-full"
                />
              )}
              <span class="font-medium">{post.primary_author.name}</span>
            </div>
          )
        }
        <span class="opacity-50">•</span>
        {
          post.published_at && (
            <time datetime={post.published_at}>
              {new Date(post.published_at).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          )
        }
        <span class="opacity-50">•</span>
        <span>{post.reading_time} min read</span>
        {
          post.tags && post.tags.length > 0 && (
            <>
              <span class="opacity-50">•</span>
              <div class="flex flex-wrap gap-2">
                {post.tags.slice(0, 3).map((tag: any) => (
                  <span class="rounded-full bg-white/10 px-3 py-1 text-xs">
                    {tag.name}
                  </span>
                ))}
              </div>
            </>
          )
        }
      </div>

      <div
        data-aos="reveal-anim-top"
        data-aos-delay="300"
        data-aos-duration="1500"
        class="prose-lg prose-invert mx-auto max-w-4xl">
        <Fragment set:html={sanitizedHtml} />
      </div>

      <div
        data-aos="reveal-anim-top"
        data-aos-delay="400"
        data-aos-duration="1500"
        class="mx-auto mt-12 max-w-4xl border-t border-inherit/10 pt-8">
        <ShareButtons
          title={post.title || ""}
          url={canonicalURL}
          description={post.meta_description ||
            post.custom_excerpt ||
            post.excerpt ||
            ""}
        />
      </div>

      {
        (prevPost || nextPost) && (
          <div
            data-aos="reveal-anim-top"
            data-aos-delay="500"
            data-aos-duration="1500"
            class="mx-auto mt-12 max-w-4xl border-t border-inherit/10 pt-8">
            <h3 class="mb-6 text-xl font-bold">Continue Reading</h3>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {prevPost && (
                <a
                  href={`/post/${prevPost.slug}`}
                  class="group hover:border-primary hover:bg-primary/5 flex flex-col rounded-lg border border-inherit/20 p-6 transition-all duration-300">
                  <div class="mb-2 text-sm text-inherit opacity-60">
                    <span aria-hidden="true">←</span> Previous
                  </div>
                  <div class="group-hover:text-primary text-lg font-semibold transition-colors duration-300">
                    {prevPost.title}
                  </div>
                </a>
              )}
              {nextPost && (
                <a
                  href={`/post/${nextPost.slug}`}
                  class="group hover:border-primary hover:bg-primary/5 flex flex-col rounded-lg border border-inherit/20 p-6 transition-all duration-300 md:text-right">
                  <div class="mb-2 text-sm text-inherit opacity-60">
                    Next <span aria-hidden="true">→</span>
                  </div>
                  <div class="group-hover:text-primary text-lg font-semibold transition-colors duration-300">
                    {nextPost.title}
                  </div>
                </a>
              )}
            </div>
          </div>
        )
      }

      <RelatedPosts relatedPosts={relatedPosts as any} />
    </div>
  </section>
</Base>
